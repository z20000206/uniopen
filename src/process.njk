{% extends './_layouts/_layout.tmpl' %}

{% set headerType = "process" %}

{% block title %}uniopen 申辦綁定流程全攻略{% endblock %}

{% block content %}
    <div class="l-block">
        <div class="l-block__item l-block__item--process">
            <div class="l-block__content">
                <div class="c-unitBanner">
                    <div class="c-unitBanner__subTitle">申辦綁定流程全攻略</div>
                    <div class="c-unitBanner__title">
                        <img src="./content/images/section/kv/uniopen.svg" alt="uniopen 聯名卡">聯名卡</div>
                    <div class="c-unitBanner__item">
                        <p>OPEN中信銀行APP</p>
                        <p>簡單 <span class="c-unitBanner__num">5</span> 步驟完成會員連結及領券</p>
                    </div>
                    <div class="c-unitBanner__item">
                        <p>消費回饋最高 <span class="c-unitBanner__num">11%</span></p>
                    </div>
                </div>
                {%- for item in [
                    {
                        step: 1,
                        title: '申辦卡片',
                        subTitle: '有中信卡可直接申辦<br>若沒有請準備身分證、財力證明文件',
                        desc: '(無中信帳戶者，請準備他行帳號或信用卡)',
                        content: [
                            { text:'開始申請' },
                            { text:'輸入資料'},
                            { text:'選擇卡等與儲值卡' },
                            { text:'填寫他行認證資訊', gy:'(無中國信託帳戶者)' },
                            { text:'同意條款', og:'行動支付條款務必勾選' },
                            { text:'依據說明完成辦卡' }
                        ]
                    },{
                        step: 2,
                        title: '申辦卡片',
                        subTitle: '有中信卡可直接申辦<br>若沒有請準備身分證、財力證明文件',
                        desc: '(無中信帳戶者，請準備他行帳號或信用卡)',
                        content: [
                            { text:'登入中信銀行APP' },
                            { text:'選擇卡片管理'},
                            { text:'點選uniopen會員連結' },
                            { text:'點擊立即連結' },
                            { text:'確認手機號碼' },
                            { text:'依據說明完成連結<br>並點擊確定' },
                            { text:'完成連結' }
                        ]
                    },{
                        step: 3,
                        title: '綁定行動支付',
                        subTitle: '快速綁定 立即消費免等實體卡',
                        content: [
                            { text:'於卡片管理下滑<br>找到支付綁定' },
                            { text:'點擊家樂福錢包', gy: '(或其他欲綁定的行動支付)' },
                            { text:'安裝家樂福APP<br>並回到中信銀行APP' },
                            { text:'選擇uniopen聯名卡<br>進行綁定' },
                            { text:'依據說明完成綁定' }
                        ]
                    },{
                        step: 4,
                        title: '領優惠券',
                        subTitle: '領券並完成指定任務<br>享踩點任務、國外消費加碼最高 <span class="t-pl t-bold t4 t-lh12">11%</span>',
                        desc: '(無中信帳戶者，請準備他行帳號或信用卡)',
                        content: [
                            { text:'選擇卡片管理' },
                            { text:'點擊卡友專屬券'},
                            { text:'點擊領取' },
                            { text:'點擊查看我的優惠券' },
                            { text:'查看已領取的優惠券' }
                        ]
                    },{
                        step: 5,
                        title: '查詢點數',
                        subTitle: '隨時隨地 查詢回饋點數超輕鬆',
                        content: [
                            { text:'選擇卡片管理' },
                            { text:'點擊回饋點數明細'},
                            { text:'查詢uniopen聯名卡回饋' },
                            { text:'點擊會員帳號' },
                            { text:'可查詢入點帳號' }
                        ]
                    }
                ] -%}
                    <!-- Step {{ loop.index }} -->
                    <div class="c-process">
                        <div class="c-process__title">
                            <div class="c-title">
                                <div class="c-title__head">
                                    <div class="c-title__icon">
                                        <div class="o-icon o-icon--line"></div>
                                    </div>
                                    <div class="c-title__text">
                                        <span class="t-pl">Step {{ loop.index }}
                                        </span>{{ item.title }}</div>
                                    <div class="c-title__icon c-title__icon--right">
                                        <div class="o-icon o-icon--lineRight"></div>
                                    </div>
                                </div>
                                <div class="c-title__discount u-tac">{{ item.subTitle | safe }}</div>
                                {%- if item.desc -%}
                                    <div class="c-title__date">{{ item.desc | safe }}</div>
                                {%- endif -%}
                            </div>
                        </div>
                        <!-- [data-swiper]：輪播呼叫套件識別用，必需要唯一值不可重複，請參考頁面下方 javascript 邏輯。 -->
                        <div class="c-process__wrap">
                            <div class="c-process__content">
                                <!-- [data-swiper]：輪播呼叫套件識別用，必需要唯一值不可重複，請參考頁面下方 javascript 邏輯。 -->
                                <div class="c-carousel c-carousel--process swiper" data-swiper="process">
                                    <div class="c-carousel__wrapper swiper-wrapper">
                                        {%- for content in item.content -%}
                                            <div class="c-carousel__slide swiper-slide">
                                                <div class="c-processCard">
                                                    <div class="c-processCard__title">{{ loop.index }}. {{ content.text | safe }}
                                                        {%- if content.gy or content.og -%}
                                                            <div class="t-{{ 'gy' if content.gy else 'og' }}">{{ content.gy or content.og }}</div>
                                                        {%- endif -%}
                                                    </div>
                                                    <div class="c-processCard__img">
                                                        <img src="./content/images/section/process/step{{ item.step }}/step{{ item.step }}-{{ loop.index }}.png" alt="step1-{{ loop.index }}">
                                                    </div>
                                                </div>
                                            </div>
                                        {%- endfor -%}
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="c-process__action">
                            <a href="#" class="o-btn" target="_blank" data-mfp-src="#step1popup" data-mfp-alert>教學影片</a>
                        </div>
                    </div>
                {%- endfor -%}
            </div>
        </div>
    </div>
{% endblock %}

{% block popups %}
    {%- include './_partials/_popups.part' -%}
{% endblock %}

{% block scripts %}
    <script>
        // swiper
        const processSettings = $.extend(true, {}, carouselSettings, {
            slidesPerView: 'auto',
            loop: false,
            autoplay: false
        });
        processSwiper = new Swiper('[data-swiper="process"]', processSettings);
    </script>
{% endblock %}