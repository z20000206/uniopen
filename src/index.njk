                                                    <div class="o-iconBox__icon">
                                                        <i class="o-icon o-icon--external"></i>
                                                    </div>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                {%- endfor -%}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
