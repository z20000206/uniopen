                                            <span class="c-enjoyCard__num">11</span>
                                            <span class="t-pl t-bold u-mt-lg">%</span>
                                        </div>
                                        <div class="c-enjoyCard__icon">
                                            <a href="#" class="c-popupIcon" data-mfp-src="#carrefourWalletPopup">
                                                <i class="o-icon o-icon--arrow"></i>
                                            </a>
                                        </div>
                                    </div>
                                    <div class="c-enjoyCard__item">
                                        <div class="c-enjoyCard__title">國外消費</div>
                                        <div class="c-enjoyCard__discount">
                                            <span class="t7">最高</span>
                                            <span class="c-enjoyCard__num">11</span>
                                            <span class="t-pl t-bold u-mt-lg">%</span>
