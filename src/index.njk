                                    </div>
                                    <div class="c-extravagantCard__add">
                                        <i class="o-icon o-icon--add"></i>
                                    </div>
                                    <div class="c-extravagantCard__item">
                                        <div class="c-extravagantCard__title">完成指定任務</div>
                                        <div class="c-extravagantCard__feedback">
                                            <span>最高加碼</span>
                                            <span class="c-extravagantCard__num u-mb2">4</span>
                                            <span class="t4 t-bold t-og">%</span>
                                        </div>
                                    </div>
                                    <div class="c-extravagantCard__high">
                                        <div class="c-extravagantCard__title t-wh">最高回饋</div>
                                        <div class="c-extravagantCard__feedback">
                                            <span class="c-extravagantCard__num t2 t-wh">11</span>
                                            <span class="t5 t-wh">%</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="c-extravagant__panel u-hidden" data-panel="intl">
                                <div class="c-extravagantCard">
                                    <div class="c-extravagantCard__item c-extravagantCard__item--md">
                                        <div class="c-extravagantCard__title">指定國家消費</div>
                                        <div class="c-extravagantCard__feedback">
                                            <span>最高回饋</span>
                                            <span class="c-extravagantCard__num u-mb2">8</span>
                                            <span class="t4 t-bold t-og">%</span>
                                        </div>
                                        <div class="c-extravagantCard__more">日本/韓國/泰國/越南/菲律賓限定</div>
                                    </div>
                                    <div class="c-extravagantCard__add">
                                        <i class="o-icon o-icon--add"></i>
                                    </div>
                                    <div class="c-extravagantCard__item">
                                        <div class="c-extravagantCard__title">國外實體商店消費</div>
                                        <div class="c-extravagantCard__feedback">
                                            <span>回饋</span>
                                            <span class="c-extravagantCard__num u-mb2">3</span>
                                            <span class="t4 t-bold t-og">%</span>
                                        </div>
                                        <div class="c-extravagantCard__more">原消費回饋</div>
                                    </div>
                                    <div class="c-extravagantCard__high">
                                        <div class="c-extravagantCard__title t-wh">最高回饋</div>
                                        <div class="c-extravagantCard__feedback">
                                            <span class="c-extravagantCard__num t2 t-wh">11</span>
                                            <span class="t5 t-wh">%</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="c-extravagant__more">
                                <a href="#" class="o-iconBox">
                                    <div class="o-iconBox__text t-wh">活動詳情</div>
                                    <div class="o-iconBox__icon">
                                        <i class="o-icon o-icon--arrow t-bg-wh"></i>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="c-extravagant__img">
                        <img src="./content/images/section/extravagant/takeCard.jpg" alt="開啟你的輕奢體驗">
                    </div>
                </div>
            </div>
        </section>
        <section id="enjoy" class="l-block__item l-block__item--enjoy">
            <div class="l-block__content">
                <div class="c-enjoy">
                    <div class="c-enjoy__wrap">
                        <div class="c-enjoy__title">
                            <div class="c-title">
                                <div class="c-title__head">
                                    <div class="c-title__icon">
                                        <div class="o-icon o-icon--line"></div>
                                    </div>
                                    <div class="c-title__text">開啟你的享樂日常</div>
                                    <div class="c-title__icon c-title__icon--right">
                                        <div class="o-icon o-icon--lineRight"></div>
                                    </div>
                                </div>
                                <div class="c-title__date">2025/7/11~2025/12/31</div>
                                <div class="c-title__discount">消費回饋OPENPOINT無上限</div>
                            </div>
                        </div>
                        <div class="c-enjoy__content">
                            <div class="c-enjoy__card">
                                <div class="c-enjoyCard">
                                    <div class="c-enjoyCard__item">
                                        <div class="c-enjoyCard__title">
                                            <span>國內</span>
                                            <span>一般消費</span></div>
                                        <div class="c-enjoyCard__discount">
                                            <span>最高</span>
                                            <span class="c-enjoyCard__num">1</span>
                                            <span class="t-og">%</span>
                                        </div>
                                    </div>
                                    <div class="c-enjoyCard__item">
                                        <div class="c-enjoyCard__title">
                                            <span>國外非實體</span>
                                            <span>商店消費</span></div>
                                        <div class="c-enjoyCard__discount">
                                            <span>最高</span>
                                            <span class="c-enjoyCard__num">2</span>
                                            <span class="t-og">%</span>
                                        </div>
                                    </div>
                                    <div class="c-enjoyCard__item">
                                        <div class="c-enjoyCard__title">
                                            <span>國外實體</span>
                                            <span>商店消費</span></div>
                                        <div class="c-enjoyCard__discount">
                                            <span>最高</span>
                                            <span class="c-enjoyCard__num">3</span>
                                            <span class="t-og">%</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="c-enjoy__bg"></div>
                        </div>
                        <div class="c-enjoy__more">
                            <a href="#" class="o-iconBox">
                                <div class="o-iconBox__text">活動詳情</div>
                                <div class="o-iconBox__icon">
                                    <i class="o-icon o-icon--arrow"></i>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <section id="savor" class="l-block__item l-block__item--savor">
            <div class="l-block__content">
                <div class="c-savor">
                    <div class="c-savor__wrap">
                        <div class="c-savor__title">
                            <div class="c-title">
                                <div class="c-title__head">
                                    <div class="c-title__icon">
                                        <div class="o-icon o-icon--line"></div>
                                    </div>
                                    <div class="c-title__text">開啟你的品味時光</div>
                                    <div class="c-title__icon c-title__icon--right">
                                        <div class="o-icon o-icon--lineRight"></div>
                                    </div>
                                </div>
                                <div class="c-title__discount">20大品牌獨享優惠</div>
                            </div>
                        </div>
                        <div class="c-savor__content">
                            <div class="c-savor__nav">
                                <button class="c-savor__item is-active" data-savor-item="start">
                                    <div class="c-savor__text">主打星</div>
                                    <i class="c-savor__icon"></i>
                                </button>
                                <button class="c-savor__item" data-savor-item="parking">
                                    <div class="c-savor__text">免費停車</div>
                                    <i class="c-savor__icon"></i>
                                </button>
                                <button class="c-savor__item" data-savor-item="daily">
                                    <div class="c-savor__text">日常採購</div>
                                    <i class="c-savor__icon"></i>
                                </button>
                                <button class="c-savor__item" data-savor-item="food">
                                    <div class="c-savor__text">輕食美饌</div>
                                    <i class="c-savor__icon"></i>
                                </button>
                                <button class="c-savor__item" data-savor-item="shopping">
                                    <div class="c-savor__text">時尚購物</div>
                                    <i class="c-savor__icon"></i>
                                </button>
                                <button class="c-savor__item" data-savor-item="travel">
                                    <div class="c-savor__text">休閒旅遊</div>
                                    <i class="c-savor__icon"></i>
                                </button>
                                <button class="c-savor__item" data-savor-item="more">
                                    <div class="c-savor__text">更多權益</div>
                                    <i class="c-savor__icon"></i>
                                </button>
                                <div class="o-carouselNav o-carouselNav--savor">
                                    <!-- [data-swiper-prev]：輪播套件上一筆功能用，必需設定與輪播元件一致且不可重複，請參考頁面下方 javascript 邏輯。 -->
                                    <div class="o-carouselNav__prev swiper-button-prev" data-swiper-prev="savor"></div>
                                    <!-- [data-swiper-next]：輪播套件下一筆功能用，必需設定與輪播元件一致且不可重複，請參考頁面下方 javascript 邏輯。 -->
                                    <div class="o-carouselNav__next swiper-button-next" data-swiper-next="savor"></div>
                                </div>
                            </div>
                            <!-- [data-swiper]：輪播呼叫套件識別用，必需要唯一值不可重複，請參考頁面下方 javascript 邏輯。 -->
                            <div class="c-carousel c-carousel--savor swiper" data-swiper="savor">
                                <div class="c-carousel__wrapper swiper-wrapper">
                                    {%- set data = [
                                        {head: '主打星', data: 'start'},
                                        {head: '免費停車', data: 'parking'},
                                        {head: '日常採購', data: 'daily'},
                                        {head: '輕食美饌', data: 'food'},
                                        {head: '時尚購物', data: 'shopping'},
                                        {head: '休閒旅遊', data: 'travel'},
                                        {head: '更多權益', data: 'more'}
                                    ] -%}
                                    <!-- 主打星 -->
                                    <div class="c-carousel__slide swiper-slide" data-savor-panel="start">
                                        <div class="c-savor__panel">
                                            <div class="c-savor__card">
                                                <div class="c-savorCard">
                                                    <div class="c-savorCard__head">主打星</div>
                                                    <div class="c-savorCard__content">
                                                        {%- set data = [
                                                                {
                                                                    title: '咖啡豆、咖啡用品',
                                                                    discount: '每週四享<span class="c-savorCard__num">9</span>折優惠',
                                                                    img:'beans'
                                                                },
                                                                {
                                                                    title: '大杯(含)以上飲料',
                                                                    discount: '每月首週週一享買<span class="c-savorCard__num">1</span>送<span class="c-savorCard__num">1</span>',
                                                                    img:'coffee'
                                                                }
                                                            ] -%}
                                                        {% for item in data %}
                                                            <div class="c-savorCard__item">
                                                                <div class="c-savorCard__introduce">
                                                                    <div class="c-savorCard__title">{{ item.title }}</div>
                                                                    <div class="c-savorCard__discount">{{ item.discount | safe }}</div>
                                                                </div>
                                                                {% if item.img %}
                                                                    <div class="c-savorCard__img">
                                                                        <img src="./content/images/section/savor/{{ item.img }}.png" alt="{{ item.img }}">
                                                                    </div>
                                                                {% endif %}
                                                            </div>
                                                        {% endfor %}
                                                        <div class="c-savorCard__btn">
                                                            <div class="o-btnBox">
                                                                <div class="o-btnBox__icon">
                                                                    <i class="o-icon o-icon--open"></i>
                                                                </div>
                                                                <div class="o-btnBox__text">看全部優惠</div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="c-savorCard__footer">
                                                        <a href="#" class="o-iconBox">
                                                            <div class="o-iconBox__text">活動詳情</div>
                                                            <div class="o-iconBox__icon">
                                                                <i class="o-icon o-icon--arrow"></i>
                                                            </div>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="c-savor__img has-starbucksLogo">
                                                <img src="./content/images/section/savor/start.jpg" alt="主打星">
                                            </div>
                                        </div>
                                    </div>
                                    <!-- 免費停車 -->
                                    <div class="c-carousel__slide swiper-slide" data-savor-panel="parking">
                                        <div class="c-savor__panel">
                                            <div class="c-savor__card">
                                                <div class="c-savorCard">
                                                    <div class="c-savorCard__head">免費停車</div>
                                                    <div class="c-savorCard__content">
                                                        {%- set data = [
                                                                {
                                                                    title: '家樂福',
                                                                    discount: '不限金額<span class="c-savorCard__num">1</span>小時',
                                                                    img:''
                                                                },
                                                                {
                                                                    title: '統一時代百貨',
                                                                    discount: '消費滿500元<span class="c-savorCard__num">2</span>小時',
                                                                    img:''
                                                                },
                                                                {
                                                                    title: '統一夢時代百貨',
                                                                    discount: '<span class="c-savorCard__num">2</span>小時',
                                                                    img:''
                                                                },
                                                                {
                                                                    title: '市區停車',
                                                                    discount: '達指定消費門檻<span class="c-savorCard__num">2</span>小時',
                                                                    img:''
                                                                }
                                                            ] -%}
                                                        {% for item in data %}
                                                            <div class="c-savorCard__item">
                                                                <div class="c-savorCard__introduce">
                                                                    <div class="c-savorCard__title">{{ item.title }}</div>
                                                                    <div class="c-savorCard__discount">{{ item.discount | safe }}</div>
                                                                </div>
                                                                {% if item.img %}
                                                                    <div class="c-savorCard__img">
                                                                        <img src="./content/images/section/savor/{{ item.img }}.png" alt="{{ item.img }}">
                                                                    </div>
                                                                {% endif %}
                                                            </div>
                                                        {% endfor %}
                                                        <div class="c-savorCard__btn">
                                                            <div class="o-btnBox">
                                                                <div class="o-btnBox__icon">
                                                                    <i class="o-icon o-icon--open"></i>
                                                                </div>
                                                                <div class="o-btnBox__text">看全部優惠</div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="c-savorCard__footer">
                                                        <a href="#" class="o-iconBox">
                                                            <div class="o-iconBox__text">活動詳情</div>
                                                            <div class="o-iconBox__icon">
                                                                <i class="o-icon o-icon--arrow"></i>
                                                            </div>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="c-savor__img">
                                                <img src="./content/images/section/savor/parking.jpg" alt="免費停車">
                                            </div>
                                        </div>
                                    </div>
                                    <!-- 日常採購 -->
                                    <div class="c-carousel__slide swiper-slide" data-savor-panel="daily">
                                        <div class="c-savor__panel">
                                            <div class="c-savor__card">
                                                <div class="c-savorCard">
                                                    <div class="c-savorCard__head">日常採購</div>
                                                    <div class="c-savorCard__content">
