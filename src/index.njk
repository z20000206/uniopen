                                </div>
                                <div class="c-discountCard__total">限量7111名</div>
                            </div>
                            <div class="c-discountCard">
                                <div class="c-discountCard__head">
                                    <span>專屬好禮</span>
                                    <i class="o-icon o-icon--lineLg"></i>
                                </div>
                                <div class="c-discountCard__content">
                                    <div class="c-discountCard__date">2025/7/11~2025/9/30</div>
                                    <div class="c-discountCard__task">
