{% extends './_layouts/_layout.tmpl' %}

{% block title %}中國信託 uniopen 聯名卡{% endblock %}

{% block content %}
    <div class="l-block">
        <!-- KV -->
        <section id="kv" class="l-block__item l-block__item--kv">
            <div class="l-block__wrap">
                <div class="l-block__content">
                    <div class="c-kv">
                        <div class="c-kv__content">
                            <div class="c-kv__item" data-aos="zoom-in-up">
                                <div class="c-kv__introduce">
                                    <div class="c-kv__slogan">我的世界 由我OPEN</div>
                                    <div class="c-kv__title">
                                        <img class="c-kv__img" src="./content/images/section/kv/uniopen.svg" alt="uniopen">
                                        聯名卡
                                    </div>
                                    <div class="c-kv__discount u-mt-lg">消費回饋最高享 <span class="c-kv__discount c-kv__discount--highlight">11%</span></div>
                                    <div class="c-kv__discount">指定卡友日最優享 <span class="c-kv__discount c-kv__discount--highlight">買1送1</span></div>
                                </div>
                                <div class="c-kv__action">
                                    <a class="o-btn o-btn--kv" href="#" target="_blank" rel="noreferrer noopener" data-link>立即申辦</a>
                                </div>
                            </div>
                            <div class="c-kv__item c-kv__item--card">
                                <div class="o-card" data-aos="zoom-in-up">
                                    <div class="o-card__img" data-lottie="./content/images/section/kv/word.json"></div>
                                    <div class="o-card__name">
                                        <span>世界卡</span>
                                        <i class="o-icon o-icon--lineLg"></i>
                                    </div>
                                </div>
                                <div class="o-card" data-aos="zoom-in-up">
                                    <div class="o-card__img o-card__img--t" data-lottie="./content/images/section/kv/titanium.json"></div>
                                    <div class="o-card__name">
                                        <span>鈦金卡</span>
                                        <i class="o-icon o-icon--lineLg"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="c-kv__scroll">Scroll</div>
                    </div>
                </div>
            </div>
        </section>
