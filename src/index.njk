                            <div class="o-carouselNav__prev swiper-button-prev" data-swiper-prev="finance"></div>
                            <!-- [data-swiper-next]：輪播套件下一筆功能用，必需設定與輪播元件一致且不可重複，請參考頁面下方 javascript 邏輯。 -->
                            <div class="o-carouselNav__next swiper-button-next" data-swiper-next="finance"></div>
                        </div>
                    </div>
                    <div class="c-finance__content">
                        <!-- [data-swiper]：輪播呼叫套件識別用，必需要唯一值不可重複，請參考頁面下方 javascript 邏輯。 -->
                        <div class="c-financeCard c-carousel c-carousel--finance swiper" data-swiper="finance">
                            <div class="c-financeCard__wrap c-carousel__wrapper swiper-wrapper">
                                {%- set data = [
                                    { title:'跨轉與外幣提/存款', discount:'免手續費', text:'持有本行有效存款帳戶成功申辦uniopen聯名卡、完成三項任務', farther:'' },
                                    { title:'信貸', discount:'專屬優惠', text:'卡友於指定通路申辦成功撥貸抽OPENPOINT17', farther:'*指定通路: 專人回電、0800進線、文字客服或線上自行申請' },
                                    { title:'理財任務', discount:'月月抽OPENPOINT', text:'uniopen聯名卡並為本行存款帳戶每月新增任1筆理財設定或數位理財交易', farther:'獎項： 711點/名，月月抽200名，共1200名' }
                                ] -%}
                                {%- for item in data -%}
                                    <div class="c-financeCard__item c-carousel__slide swiper-slide">
                                        <div class="c-financeCard__head">
                                            <div class="c-financeCard__title">{{ item.title }}</div>
                                            <div class="c-financeCard__discount">{{ item.discount }}</div>
                                        </div>
                                        <div class="c-financeCard__content">
                                            <div class="c-financeCard__detail">
                                                <div class="c-financeCard__text">{{ item.text }}</div>
                                                <div class="c-financeCard__farther">{{ item.farther }}</div>
                                            </div>
                                            <div class="c-financeCard__more">
                                                <a href="#" class="o-iconBox">
