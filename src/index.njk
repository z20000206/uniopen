{% block scripts %}
<script>
    $(function () {
        // swiper 品味時光
        const savorSettings = $.extend(true, {}, carouselSettings, {
            direction: 'vertical',
            effect: window.innerWidth <= 1200
                ? 'fade'
                : 'slide',
            loop: window.innerWidth <= 1200
                ? false
                : true,
            autoHeight: true,
            slidesPerView: '1',
            allowTouchMove: false,
            autoplay: false,

            navigation: {
                prevEl: '[data-swiper-prev="savor"]',
                nextEl: '[data-swiper-next="savor"]'
            },

            on: {
                init: function (swiper) {
                    heightDetect(swiper);

                    const index = swiper.realIndex;
                    $('.c-savor__item')
                        .removeClass('is-active')
                        .eq(index)
                        .addClass('is-active');
                },

                slideChangeTransitionStart: function () {
                    const index = this.realIndex;
                    $('.c-savor__item')
                        .removeClass('is-active')
                        .eq(index)
                        .addClass('is-active');
                },

                slideChange: function (swiper) {
                    heightDetect(swiper);
                }
            }
        });

        function heightDetect(swiper) {
            var $slider = $('[data-swiper="savor"]');
            var $currentSlide = $(swiper.slides[swiper.activeIndex]);
            var $currentSlideItem = $currentSlide
                .children()
                .eq(0);
            $slider.height($currentSlideItem.outerHeight());
        }

        // 破壞重組
        const allSavorSlides = {};
        const allSavorItems = {};
        const allNavigationHTML = {};
        const savorSlideOrder = [
            'start',
            'parking',
            'daily',
            'food',
            'shopping',
            'sport',
            'travel',
            'more'
        ];

        $('[data-swiper="savor"] .swiper-slide').each(function () {
            const key = $(this).attr('data-savor-slide');
            if (key) {
                allSavorSlides[key] = $(this).prop('outerHTML');
            }
        });

        $('[data-savor-item]').each(function () {
            const key = $(this).attr('data-savor-item');
            if (key) {
                allSavorItems[key] = $(this).prop('outerHTML');
            }
        });

        $('[data-swiper-prev="savor"]').each(function () {
            allNavigationHTML.prev = $(this).prop('outerHTML');
        });
        $('[data-swiper-next="savor"]').each(function () {
            allNavigationHTML.next = $(this).prop('outerHTML');
        });

        const $navContainer = $('.o-carouselNav--savor');
        if ($navContainer.length > 0) {
            allNavigationHTML.container = $navContainer.prop('outerHTML');
            allNavigationHTML.containerParent = $navContainer.parent();
        }

        let savorSwiper;

        function updateSavorSwiper(order) {
            if (savorSwiper) {
                savorSwiper.destroy(true, true);
                savorSwiper = null;
            }

            const $wrapper = $('[data-swiper="savor"] .swiper-wrapper');
            const newSlides = $.map(order, key => allSavorSlides[key]);
            $wrapper
                .empty()
                .append(newSlides);

            const $itemWrapper = $('[data-savor-item]')
                .first()
                .parent();
            if ($itemWrapper.length) {
                const newItems = $.map(order, key => allSavorItems[key]);
                $itemWrapper
                    .empty()
                    .append(newItems);
            }

            let $prevBtn = $('[data-swiper-prev="savor"]');
            let $nextBtn = $('[data-swiper-next="savor"]');

            if ($prevBtn.length === 0 || $nextBtn.length === 0) {
                $('.o-carouselNav--savor').remove();

                if (allNavigationHTML.container && allNavigationHTML.containerParent) {
                    allNavigationHTML
                        .containerParent
                        .prepend(allNavigationHTML.container);
                } else if (allNavigationHTML.prev && allNavigationHTML.next) {

                    const navHTML = `
                                <div class="o-carouselNav o-carouselNav--savor">
                                    ${allNavigationHTML.prev}
                                    ${allNavigationHTML.next}
                                </div>
                            `;
                    $('[data-swiper="savor"]').before(navHTML);
                } else {
                    const navHTML = `
                                <div class="o-carouselNav o-carouselNav--savor">
                                    <div class="o-carouselNav__prev swiper-button-prev" data-swiper-prev="savor"></div>
                                    <div class="o-carouselNav__next swiper-button-next" data-swiper-next="savor"></div>
                                </div>
                            `;
                    $('[data-swiper="savor"]').before(navHTML);
                }
            }

            $('[data-savor-item]')
                .off('click')
                .on('click', function () {
                    const key = $(this).attr('data-savor-item');
                    const index = order.indexOf(key);
                    if (index !== -1) 
                        savorSwiper.slideToLoop(index);
                    
                    $('[data-savor-item]').removeClass('is-active');
                    $(this).addClass('is-active');
                });

            savorSwiper = new Swiper('[data-swiper="savor"]', savorSettings);

            const firstKey = order[0];
            $('[data-savor-item][data-savor-item="' + firstKey + '"]').addClass('is-active');
        }

        updateSavorSwiper(savorSlideOrder);

        // 品味時光小網錨點
        $('[data-savor-item]').on('click', function (e) {
            e.preventDefault();

            const $this = $(this);
            const targetKey = $this.attr('data-savor-item');
            const index = $('[data-savor-item]').index($this);
            const $target = $('[data-savor-slide="' + targetKey + '"]');

            if (savorSwiper) {
                savorSwiper.slideToLoop(index);
            }

            if (window.innerWidth < 1200) {
                if ($target.length) {
                    const offset = $target
                        .offset()
                        .top - 120;
                    $('html, body').animate({
                        scrollTop: offset
                    }, 500);

                    $('[data-savor-item]')
                        .removeClass('is-active')
                        .eq(index)
                        .addClass('is-active');
                }
            }
        });

        $(window).on('resize', () => {
            if (savorSwiper) {
                savorSwiper.update();
            }
        });

        // swiper 金融生活
        const allFinanceSlides = {};
        const allFinanceNavigationHTML = {};
        const financeSlideOrder = ['fm', 'cl-gift', 'mission', 'fund'];

        $('[data-swiper="finance"] .swiper-slide').each(function () {
            const key = $(this).attr('data-finance-slide');
            if (key) {
                allFinanceSlides[key] = $(this).prop('outerHTML');
            }
        });

        $('[data-swiper-prev="finance"]').each(function () {
            allFinanceNavigationHTML.prev = $(this).prop('outerHTML');
        });
        $('[data-swiper-next="finance"]').each(function () {
            allFinanceNavigationHTML.next = $(this).prop('outerHTML');
        });

        const $financeNavContainer = $('.o-carouselNav--finance');
        if ($financeNavContainer.length > 0) {
            allFinanceNavigationHTML.container = $financeNavContainer.prop('outerHTML');
            allFinanceNavigationHTML.containerParent = $financeNavContainer.parent();
        }

        let financeSwiper;

        function updateFinanceSwiper(order) {
            if (financeSwiper) {
                financeSwiper.destroy(true, true);
                financeSwiper = null;
            }

            const $wrapper = $('[data-swiper="finance"] .swiper-wrapper');
            const newSlides = $.map(order, key => allFinanceSlides[key]);

            $wrapper
                .empty()
                .append(newSlides);

            let $prevBtn = $('[data-swiper-prev="finance"]');
            let $nextBtn = $('[data-swiper-next="finance"]');

            if ($prevBtn.length === 0 || $nextBtn.length === 0) {
                $('.o-carouselNav--finance').remove();

                if (allFinanceNavigationHTML.container && allFinanceNavigationHTML.containerParent) {
                    allFinanceNavigationHTML
                        .containerParent
                        .prepend(allFinanceNavigationHTML.container);
                } else if (allFinanceNavigationHTML.prev && allFinanceNavigationHTML.next) {
                    const navHTML = `
                                <div class="o-carouselNav o-carouselNav--finance">
                                    ${allFinanceNavigationHTML.prev}
                                    ${allFinanceNavigationHTML.next}
                                </div>
                            `;
                    $('[data-swiper="finance"]').before(navHTML);
                } else {
                    const navHTML = `
                                <div class="o-carouselNav o-carouselNav--finance">
                                    <div class="o-carouselNav__prev swiper-button-prev" data-swiper-prev="finance"></div>
                                    <div class="o-carouselNav__next swiper-button-next" data-swiper-next="finance"></div>
                                </div>
                            `;
                    $('[data-swiper="finance"]').before(navHTML);
                }
            }

            financeSwiper = new Swiper('[data-swiper="finance"]', $.extend(true, {}, carouselSettings, {
                loop: true,
                slidesPerView: 'auto',
                autoplay: false,

                navigation: {
                    prevEl: '[data-swiper-prev="finance"]',
                    nextEl: '[data-swiper-next="finance"]'
                },

                on: {
                    init(swiper) {
                        swiper.slideTo(0, 0, false);
                    }
                }
            }));

            financeSwiper.slideTo(0);
        }

        updateFinanceSwiper(financeSlideOrder);

        // 注意事項展開收合
        $('[data-toggle]').on('click', function (e) {
            e.preventDefault();
            const key = $(this).attr('data-toggle');

            $(this)
                .find('.o-icon')
                .toggleClass('o-icon--open')
                .toggleClass('o-icon--minus');

            $(`[data-toggle-panel="${key}"]`).toggleClass('is-active');
        });

        // 卡片大小網切換(有兩套，內容調整時請同步變更 ! ! !)
        function toggleCreditCardView() {
            if ($(window).width() <= 768) {
                $('[data-view="mobile"]').removeClass('u-hidden');
                $('[data-view="desktop"]').addClass('u-hidden');
            } else {
                $('[data-view="desktop"]').removeClass('u-hidden');
                $('[data-view="mobile"]').addClass('u-hidden');
            }
        }

        $(document).ready(function () {
            toggleCreditCardView();

            $(window).on('resize', function () {
                toggleCreditCardView();
            });
        });
    });
</script>
{% endblock %}