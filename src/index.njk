{% extends './_layouts/_layout.tmpl' %}

{% block content %}
    <div class="l-block">
        <section id="kv" class="l-block__item l-block__item--kv">
            <div class="l-block__wrap">
                <div class="l-block__content">
                    <div class="c-kv">
                        <div class="c-kv__content">
                            <div class="c-kv__item">
                                <div class="c-kv__introduce">
                                    <div class="c-kv__title">中國信託 uniopen 聯名卡</div>
                                    <div class="c-kv__slogan">我的世界 從此OPEN</div>
                                    <div class="c-kv__subSlogan">消費無界限 天天享優惠</div>
                                </div>
                                <div class="c-kv__action">
                                    <a class="o-btn o-btn--lg" href="#" rel="noreferrer noopener" target="_blank">立即申辦</a>
                                </div>
                                <div class="c-kv__action--mb">
                                    <a class="o-btn" href="#" rel="noreferrer noopener" target="_blank">立即申辦</a>
                                </div>
                            </div>
                            <div class="c-kv__item c-kv__item--card">
                                <div class="o-card">
                                    <div class="o-card__img" data-lottie="./content/images/section/kv/w.json"></div>
                                    <div class="o-card__name">
                                        <span>世界卡</span>
                                        <i class="o-icon o-icon--lineLg"></i>
                                    </div>
                                </div>
                                <div class="o-card">
                                    <div class="o-card__img" data-lottie="./content/images/section/kv/t.json"></div>
                                    <div class="o-card__name">
                                        <span>鈦金卡</span>
                                        <i class="o-icon o-icon--lineLg"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="c-kv__scroll">Scroll</div>
                    </div>
                </div>
            </div>
        </section>
        <section id="video" class="l-block__item l-block__item--video">
            <div class="l-block__wrap">
                <div class="l-block__content">
                    <div class="c-video">
                        <div class="c-video__title">
